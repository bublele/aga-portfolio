# Publiczny adres bez końcowego ukośnika. Wymagany dla canonical, OG, robots i sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcjonalne, publiczne tokeny weryfikacji własności w Google Search Console i Bing.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Własne zdarzenia Vercel wymagają planu Pro/Enterprise. Hobby: pozostaw false.
NEXT_PUBLIC_VERCEL_CUSTOM_EVENTS_ENABLED=false

# GTM i GA4. Oba identyfikatory są publiczne; puste wartości wyłączają analitykę.
# GA4 konfigurujemy w kontenerze GTM, bez drugiego skryptu gtag.js w aplikacji.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
